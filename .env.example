# ============================================================
# Melisco Gadgets Environment Template
# ============================================================
# In static frontend applications (hosted on Cloudflare Pages),
# configuration is set in js/config.js.
#
# Enter your project values into js/config.js:
#   SUPABASE_CONFIG = {
#     url: "https://your-project-ref.supabase.co",
#     anonKey: "your-anon-public-key-here",
#     storageBucket: "product-images"
#   };
#
# If you are using build tooling or serverless proxy functions,
# use the following environment variables:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Business WhatsApp Phone Number (International format, no '+')
STORE_WHATSAPP_NUMBER=2348000000000

# WARNING: NEVER place your SUPABASE_SERVICE_ROLE_KEY in frontend code!
# The service-role key bypasses Row Level Security and must remain private.
